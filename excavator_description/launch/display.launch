<launch>
  <arg
    name="model" />
  <arg
    name="gui"
    default="False" />
  <param
    name="robot_description"
    textfile="$(find excavator_description)/robots/marm_description1.urdf" />
  <param
    name="use_gui"
    value="$(arg gui)" /> 
<node
    name="joint_state_publisher_gui"
    pkg="joint_state_publisher_gui"
    type="joint_state_publisher_gui" />

<node
    name="robot_state_publisher"
    pkg="robot_state_publisher"
    type="robot_state_publisher" />

  <node
    name="$(anon rviz)"
    pkg="rviz"
    type="rviz"
    launch-prefix=""
    respawn="false"
    args="-d $(find marm_description)/urdf.rviz"
    output="screen" />
</launch>
